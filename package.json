    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.61.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.3"
