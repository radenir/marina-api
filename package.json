    "revoke-partner-key": "tsx scripts/revoke-partner-key.ts"
  },
  "dependencies": {
    "argon2": "^0.31.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.14",
