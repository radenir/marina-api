{
  "name": "marina-api",
  "version": "1.0.0",
  "description": "Standalone secure auth API for Marina Health",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build-seafarer-form": "tsx scripts/build-seafarer-form.ts",
    "start": "node dist/src/index.js",
    "migrate": "tsx migrations/run.ts",
    "generate-keys": "tsx scripts/generate-keys.ts",
    "migrate-legacy-users": "tsx scripts/migrate-legacy-users.ts",
    "provision-partner-key": "tsx scripts/provision-partner-key.ts",
